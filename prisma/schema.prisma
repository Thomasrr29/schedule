// Modelo de datos — app de cruce de horarios (ITM).
// La URL de conexión vive en prisma7.config.ts, no aquí (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Dia {
  lun
  mar
  mie
  jue
  vie
  sab
}

enum TipoBloque {
  OCUPADO // clase de la U, clase de bachata — presente pero no interrumpible
  DISPONIBLE // "los miercoles voy a la U de 12 a 4" — presente y libre
}

enum OrigenBloque {
  foto
  manual
}

enum EstadoAmistad {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  carnet    String   @unique
  pinHash   String // bcrypt del PIN de 4 digitos — nunca en texto plano
  createdAt DateTime @default(now())

  // Bloqueo por intentos. En la DB y no en memoria: sobrevive a redeploys de
  // Railway y al reinicio del dev server, que si no borran el contador.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  // Tope de fotos por día. Mismo criterio que el bloqueo: en la base y no en
  // memoria, porque un Map no sobrevive a un redeploy ni a otra invocación.
  // La fecha es "YYYY-MM-DD" en hora de Medellín para no hacer cuentas de UTC.
  extraccionesFecha String?
  extraccionesHoy   Int     @default(0)

  schedules    Schedule[]
  deviceTokens DeviceToken[]
  invitacion   Invitacion?
  amistadesEnviadas  Friendship[] @relation("Solicitante")
  amistadesRecibidas Friendship[] @relation("Destinatario")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 del token de la cookie
  createdAt DateTime @default(now())

  @@index([userId])
}

model Friendship {
  id            String        @id @default(uuid())
  solicitanteId String
  solicitante   User          @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatarioId String
  destinatario  User          @relation("Destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  status        EstadoAmistad @default(PENDING)
  createdAt     DateTime      @default(now())
  respondedAt   DateTime?

  // Evita mandar la misma solicitud dos veces. El caso A->B cuando ya existe
  // B->A no lo cubre el indice: se valida en el route handler antes de crear.
  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, status])
}

/// Las sedes son datos, no código: agregar una es insertar una fila, no una
/// migración y un deploy. `alias` existe porque en el horario del ITM la sede
/// viene embebida en texto libre ("N-310 FRATERNIDAD MEDELLÍN (MAÑANA)") y no
/// siempre escrita igual.
model Sede {
  id     String   @id // slug: "robledo"
  nombre String   @unique // "Robledo" — lo que se muestra
  alias  String[] // formas en que aparece escrita en el horario
  orden  Int      @default(0) // para que el dropdown salga siempre igual

  bloques TimeBlock[]
}

/// Un link por persona, estable y reusable: se pega en el grupo de WhatsApp y
/// listo. Con ~8 parceros que uno invita a mano, el flujo de solicitud y
/// aceptación protege de una amenaza que no existe. Regenerar el código es la
/// salida si el link se filtra.
model Invitacion {
  codigo    String   @id // corto y legible, sin caracteres confundibles
  emisorId  String   @unique
  emisor    User     @relation(fields: [emisorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termLabel String // ej "2026-2"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks TimeBlock[]

  @@unique([userId, termLabel])
}

model TimeBlock {
  id         String       @id @default(uuid())
  scheduleId String
  schedule   Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  titulo     String // "Calculo III", "Bachata", "Estudiar"
  dia        Dia
  horaInicio String // "HH:MM" 24h, siempre con cero a la izquierda
  horaFin    String // "HH:MM" 24h
  sedeId     String
  sede       Sede         @relation(fields: [sedeId], references: [id])
  aula       String? // "C-308" — dónde exactamente, no solo en qué sede
  tipo       TipoBloque   @default(OCUPADO)
  origen     OrigenBloque @default(foto) // para no rehacer los manuales al resubir

  @@index([scheduleId, dia, sedeId])
}
